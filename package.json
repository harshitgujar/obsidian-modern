{
  "name": "runagon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "esbuild server/obsidianBackend.ts --bundle --platform=node --format=cjs --outfile=dist-electron/server.cjs",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron electron/main.cjs",
    "desktop": "concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron electron/main.cjs\"",
    "package:appimage": "npm run build:all && electron-builder --linux AppImage --x64",
    "package:appimage:arm64": "npm run build:all && electron-builder --linux AppImage --arm64",
    "package:appimage:all": "npm run build:all && electron-builder --linux AppImage --x64 --arm64",
    "package:win": "npm run build:all && electron-builder --win --x64",
    "package:win:portable": "npm run build:all && electron-builder --win portable --x64",
    "package:win:nsis": "npm run build:all && electron-builder --win nsis --x64"
  },
  "description": "Runagon - Personal Knowledge Base & AI Memory",
  "author": "Runagon Team",
  "build": {
    "appId": "com.runagon.app",
    "productName": "Runagon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sandbox",
        "to": "resources/sandbox",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "runagon",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "runagon",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Runagon"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-portable.exe"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
